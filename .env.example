# Server
PORT=3000
NODE_ENV=production

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/frntcoda?retryWrites=true&w=majority

# Firebase Authentication
FIREBASE_PROJECT_ID=frnt-coda
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@frnt-coda.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n"
# JWT_SECRET is not used for Firebase authentication

# Application URLs
APP_URL=https://frntcoda-k8wx.onrender.com
CORS_ORIGIN=https://frntcoda-k8wx.onrender.com

# Paystack
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key

# Resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=frNtcOda <no-reply@frntcoda.com>

# Initial admin account
ADMIN_EMAIL=admin@frntcoda.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=frNtcOda Administrator
