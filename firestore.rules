rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────

    function isAuth()  { return request.auth != null; }

    function uid()     { return request.auth.uid; }

    function isOwner(id) { return isAuth() && uid() == id; }

    // Only call when you genuinely need the role — costs a read

    function userRole() {
      return get(/databases/$(database)/documents/users/$(uid())).data.role;
    }

    function isAdmin() { return isAuth() && userRole() == 'admin'; }

    // Prevent users from writing sensitive fields themselves

    function notChangingRole() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role']);
    }

    // ─── PENDING USERS ──────────────────────────────────────────────

    match /pending_users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ─── USERS ──────────────────────────────────────────────────────

    match /users/{userId} {
      allow read:   if isAuth();
      allow create: if isOwner(userId);

      // Users can update their own profile but NOT change their role

      allow update: if isOwner(userId) && notChangingRole()
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── COURSES ────────────────────────────────────────────────────

    match /courses/{courseId} {

      // Public: only live courses. Auth: see live + scheduled + own pending

      allow read: if resource.data.status == 'live'
               || (isAuth() && (
                    resource.data.status == 'scheduled'
                 || resource.data.tutorId == uid()
                 || isAdmin()
                ));

      allow create: if isAuth()
                    && request.resource.data.tutorId == uid()
                    && request.resource.data.status == 'pending';

      allow update: if isAuth() && (resource.data.tutorId == uid() || isAdmin());
      allow delete: if isAuth() && (resource.data.tutorId == uid() || isAdmin());
    }

    // ─── ENROLLMENTS ────────────────────────────────────────────────

    match /enrollments/{enrollId} {
      // Students see their own; tutors see enrollments for courses they own; admins see all
      allow read: if isAuth() && (
        resource.data.studentId == uid() ||
        isAdmin() ||
        get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.tutorId == uid()
      );
      allow create: if isAuth() && request.resource.data.studentId == uid();
      allow update: if isAuth() && resource.data.studentId == uid();
      allow delete: if isAdmin();
    }

    // ─── SUBMISSIONS ────────────────────────────────────────────────

    match /submissions/{subId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.studentId == uid();
      allow update: if isAuth() && resource.data.studentId == uid();
      allow delete: if isAuth() && resource.data.studentId == uid();
    }

    // ─── EXAM SUBMISSIONS ───────────────────────────────────────────

    match /examSubmissions/{subId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.studentId == uid();
      allow update: if isAuth() && resource.data.studentId == uid();
      allow delete: if isAuth() && resource.data.studentId == uid();
    }

    // ─── TEST RESULTS ───────────────────────────────────────────────

    match /testResults/{resultId} {
      allow read:   if isAuth() && (resource.data.studentId == uid() || isAdmin());
      allow create: if isAuth() && request.resource.data.studentId == uid();
      allow update: if isAuth() && resource.data.studentId == uid();
      allow delete: if isAdmin();
    }

    // ─── CERTIFICATES ───────────────────────────────────────────────

    match /certificates/{certId} {

      // Anyone can verify a certificate by reading it (for share links)

      allow read:   if true;
      allow create: if isAuth() && request.resource.data.studentId == uid();
      allow update: if isAuth() && resource.data.studentId == uid();
      allow delete: if isAdmin();
    }

    // ─── PAYMENTS ───────────────────────────────────────────────────

    match /payments/{payId} {

      // Students see their own payments; tutors see payments for their courses; admins see all

      allow read:   if isAuth() && (
                      resource.data.studentId == uid() ||
                      resource.data.tutorId   == uid() ||
                      isAdmin()
                    );
      allow create: if isAuth() && request.resource.data.studentId == uid();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── PAYOUTS ────────────────────────────────────────────────────

    match /payouts/{payoutId} {

      // Tutors can see their own payout records

      allow read:   if isAuth() && (resource.data.tutorId == uid() || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── NOTIFICATIONS ──────────────────────────────────────────────

    match /notifications/{notifId} {
      allow read:   if isAuth() && resource.data.userId == uid();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == uid();
      allow delete: if isAuth() && resource.data.userId == uid();
    }

  }
}
